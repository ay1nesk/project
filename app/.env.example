# Скопируйте этот файл в app/.env и заполните значения.
# Файл .env не попадает в git (см. .gitignore).

# Токен бота от @BotFather — обязательный параметр
BOT_TOKEN=

# Telegram ID администраторов через запятую (для /admin, задача #41)
ADMIN_IDS=

# Уровень логирования: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Подключение к PostgreSQL (задача #15)
DATABASE_URL=postgresql+asyncpg://habitbot:password@localhost:5432/habitbot

# Подключение к Redis для состояний диалогов
REDIS_URL=redis://localhost:6379/0
